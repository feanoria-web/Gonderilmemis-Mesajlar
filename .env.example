# Discord Bot Token
# Discord Developer Portal'dan al: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Merkez Onay Kanalı ID'si
# Tüm mesajlar bu kanala düşer, ekip burada onaylar/reddeder
# Kanal ID'sini almak için: Kanala sağ tıkla > "Kanal Kimliğini Kopyala"
APPROVAL_CHANNEL_ID=123456789012345678

# Ekip Rolü ID'si (opsiyonel)
# Yeni mesaj geldiğinde bu rol etiketlenir
# Rol ID'sini almak için: Role sağ tıkla > "Rol Kimliğini Kopyala"
TEAM_ROLE_ID=123456789012345678
